# Copy to .env.migrate (gitignored) for scripts/db.sh / npm run db:*.
# Supabase Dashboard → Connect → Session pooler (port 5432). Contains the DB
# password: never commit the real file.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
