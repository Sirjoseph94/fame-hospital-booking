{
  "name": "hospital-booking-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib types",
    "eas": "npx --yes eas-cli",
    "test": "TZ=UTC jest",
    "db:status": "bash scripts/db.sh status",
    "db:plan": "bash scripts/db.sh plan",
    "db:push": "bash scripts/db.sh push",
    "db:baseline": "bash scripts/db.sh baseline",
    "db:new": "bash scripts/db.sh new",
    "db:test": "bash scripts/db.sh test",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check:linux": "bash scripts/check-linux.sh",
    "lock:regen": "bash scripts/regen-lockfile.sh",
    "eas-build-pre-install": "node scripts/check-lockfile.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.108.4",
    "date-fns": "^3.6.0",
    "expo": "~58.0.26",
    "expo-calendar": "~58.0.8",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "lucide-react-native": "^1.47.0",
    "nativewind": "4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/supabase/",
      "/.agents/",
      "/skills/",
      "/dist/"
    ]
  }
}
