# Local development only. EAS builds and web deploys read EAS environment
# variables instead (npx eas-cli env:list --environment production). See RUNBOOK §13.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: artificial delay for scheduling API (ms). Defaults to 550 in dev, 0 in production builds.
EXPO_PUBLIC_SCHEDULING_LATENCY_MS=0

# Server-side secrets do NOT go in this file (anything here can end up in the
# app bundle). Set these as Supabase Edge Function secrets instead
# (Dashboard → Edge Functions → Secrets, or `supabase secrets set`):
#   NOTIFICATION_WEBHOOK_SECRET  required; also add it as the webhook's x-webhook-secret header
#   RESEND_API_KEY, NOTIFICATION_FROM_EMAIL, TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER
# See docs/RUNBOOK.md §12.
